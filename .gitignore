# ── Laravel Backend ──
/vendor
/node_modules
/.env
/.env.backup
/.env.production
/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
!storage/logs/.gitkeep
!storage/framework/.gitkeep
!storage/framework/cache/.gitkeep
!storage/framework/sessions/.gitkeep
!storage/framework/views/.gitkeep
/bootstrap/cache/*
!bootstrap/cache/.gitkeep

# ── Frontend (React/Vite) ──
/frontend/node_modules
/frontend/dist
/frontend/.vite

# ── IDE & OS ──
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──
*.log
npm-debug.log*

# ── Testing ──
/coverage
/.phpunit.result.cache

# ── Build artifacts ──
*.cache
.php-cs-fixer.cache

# ── Gemini/Antigravity brain (local only) ──
.gemini/
.agents/
